import Kapla.Core

namespace Kapla

/-- Construct a fresh placement request. Its y coordinate is derived by `place`. -/
def requestBlock (id : Nat) (x z : Int) (orientation : Nat) : Block :=
  ⟨id, x, 0, z, ⟨orientation % 6, Nat.mod_lt _ (by decide)⟩⟩

/-- Generate a recognizable construction using the same placement path as the player. -/
def presetRequests (name : String) : List Block := Id.run do
  let mut ps : Array Block := #[]
  if name = "tower" then
    for layer in [:36] do
      if layer % 2 = 0 then
        ps := ps.push (requestBlock ps.size (-15) (-15) 0)
        ps := ps.push (requestBlock ps.size (-15) 9 0)
      else
        ps := ps.push (requestBlock ps.size (-15) (-15) 1)
        ps := ps.push (requestBlock ps.size 9 (-15) 1)
  else if name = "bridge" then
    for _ in [:10] do
      ps := ps.push (requestBlock ps.size (-18) (-15) 1)
      ps := ps.push (requestBlock ps.size 12 (-15) 1)
    for i in [:5] do
      ps := ps.push (requestBlock ps.size (-15) ((i : Int) * 6 - 15) 0)
    ps := ps.push (requestBlock ps.size (-15) (-15) 2)
    ps := ps.push (requestBlock ps.size (-15) 13 2)
  else if name = "domino" then
    for i in [:24] do
      ps := ps.push (requestBlock ps.size (-3) ((i : Int) * 9 - 108) 4)
  else if name = "overhang" then
    ps := ps.push (requestBlock 0 (-15) (-3) 0)
    ps := ps.push (requestBlock 1 12 (-3) 0)
  return ps.toList

/-- Canonical newest-first scene generated by replaying a preset's requests. -/
def makePreset (name : String) (budget : Nat) : List Block :=
  (replay budget [] (presetRequests name)).getD []

end Kapla
